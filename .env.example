# Materia KV add-on credentials — copy from `clever addon env <addon-name>`.
# KV_HOST / KV_PORT / KV_TOKEN are exposed by the add-on.
# KV_GRAPHQL_URL is the regional GraphQL endpoint (see README).

KV_HOST="your-materia-kv-host.services.clever-cloud.com"
KV_PORT=6379
KV_TOKEN="your-kv-token"

KV_GRAPHQL_URL="https://materiakv-graphql.eu-fr-1.services.clever-cloud.com/graphql"

# HTTP port the demo listens on (defaults to 8080).
# PORT=8080
